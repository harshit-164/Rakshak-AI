{
  "components": {
    "schemas": {
      "AnalysisJobCreate": {
        "additionalProperties": false,
        "properties": {
          "engine_mode": {
            "$ref": "#/components/schemas/EngineMode",
            "default": "hosted_baseline"
          }
        },
        "title": "AnalysisJobCreate",
        "type": "object"
      },
      "AnalysisJobCreated": {
        "additionalProperties": false,
        "properties": {
          "job_id": {
            "title": "Job Id",
            "type": "string"
          },
          "replayed": {
            "title": "Replayed",
            "type": "boolean"
          },
          "status": {
            "$ref": "#/components/schemas/AnalysisJobStatus"
          }
        },
        "required": [
          "job_id",
          "status",
          "replayed"
        ],
        "title": "AnalysisJobCreated",
        "type": "object"
      },
      "AnalysisJobStatus": {
        "enum": [
          "queued",
          "running",
          "completed",
          "failed"
        ],
        "title": "AnalysisJobStatus",
        "type": "string"
      },
      "AnalysisResult": {
        "additionalProperties": false,
        "properties": {
          "abstain_reasons": {
            "items": {
              "maxLength": 120,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 20,
            "title": "Abstain Reasons",
            "type": "array"
          },
          "barriers": {
            "items": {
              "$ref": "#/components/schemas/Barrier"
            },
            "maxItems": 30,
            "title": "Barriers",
            "type": "array"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/Evidence"
            },
            "maxItems": 50,
            "title": "Evidence",
            "type": "array"
          },
          "missing_information": {
            "items": {
              "maxLength": 240,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 30,
            "title": "Missing Information",
            "type": "array"
          },
          "model_score": {
            "anyOf": [
              {
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model Score"
          },
          "precursors": {
            "items": {
              "$ref": "#/components/schemas/Precursor"
            },
            "maxItems": 30,
            "title": "Precursors",
            "type": "array"
          },
          "provenance": {
            "$ref": "#/components/schemas/Provenance"
          },
          "references": {
            "items": {
              "$ref": "#/components/schemas/ReferenceCitation"
            },
            "maxItems": 30,
            "title": "References",
            "type": "array"
          },
          "relevant_rule_ids": {
            "items": {
              "$ref": "#/components/schemas/RuleId"
            },
            "title": "Relevant Rule Ids",
            "type": "array"
          },
          "review_status": {
            "enum": [
              "pending",
              "reviewed"
            ],
            "title": "Review Status",
            "type": "string"
          },
          "rule_scores": {
            "anyOf": [
              {
                "additionalProperties": {
                  "anyOf": [
                    {
                      "maximum": 1,
                      "minimum": 0,
                      "type": "number"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "propertyNames": {
                  "$ref": "#/components/schemas/RuleId"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rule Scores"
          },
          "rules_assessment": {
            "$ref": "#/components/schemas/RulesAssessment"
          },
          "schema_version": {
            "const": "1.0",
            "title": "Schema Version",
            "type": "string"
          },
          "score_kind": {
            "$ref": "#/components/schemas/ScoreKind"
          },
          "sif_label": {
            "$ref": "#/components/schemas/SifLabel"
          },
          "summary": {
            "maxLength": 800,
            "minLength": 1,
            "title": "Summary",
            "type": "string"
          },
          "unassessed_rule_ids": {
            "items": {
              "$ref": "#/components/schemas/RuleId"
            },
            "title": "Unassessed Rule Ids",
            "type": "array"
          }
