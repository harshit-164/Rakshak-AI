          "relevant_rule_ids",
          "rules_assessment",
          "unassessed_rule_ids",
          "schema_version",
          "sif_label",
          "abstain_reasons",
          "model_score",
          "score_kind",
          "rule_scores",
          "precursors",
          "barriers",
          "evidence",
          "missing_information",
          "summary",
          "references",
          "review_status",
          "provenance"
