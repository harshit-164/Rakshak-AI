# Browser-safe Supabase settings
NEXT_PUBLIC_SUPABASE_URL=
# Browser-safe publishable (sb_publishable_...) or legacy anon key. Never use sb_secret_... here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Next.js server-only backend origin
API_BASE_URL=http://127.0.0.1:8000

# FastAPI database and authentication
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
AUTH_ISSUER=
AUTH_AUDIENCE=authenticated

# Gemini hosted baseline (server only)
GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-2.5-flash

# Runtime selection and immutable artifact identity
ENGINE_MODE=hosted_baseline
MODEL_MANIFEST_URI=
MODEL_MANIFEST_SHA256=
MODEL_READ_TOKEN=

# Deployment and safeguards
ALLOWED_ORIGINS=http://localhost:3000
PUBLIC_DEMO_ONLY=true
ENABLE_EXPLICIT_FALLBACK=false
RATE_LIMITS_CONFIG=configs/rate-limits.v1.json
LOG_LEVEL=INFO
